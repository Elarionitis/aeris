# Copy to .env and fill in what you need. Every value here is optional:
# with an empty file the service still starts, trains its models, and serves
# the dashboard using deterministic tool routing.

# --- Service ---------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text                  # text | json  (use json in deployment)

# --- HTTP ------------------------------------------------------------------
# Comma-separated exact origins. In production the loose localhost regex is
# disabled automatically, so list your real frontend origin here.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Models ----------------------------------------------------------------
AUTO_TRAIN_ON_STARTUP=true       # train missing artifacts at startup
FORECAST_HORIZON_HOURS=72
ADVISORY_CACHE_TTL_SECONDS=3600
ENABLE_PROPHET_BASELINE=false    # slow, and not used for serving

# --- LLM orchestrator ------------------------------------------------------
# auto = use whichever provider below has a key. none = always deterministic.
# auto = use whichever provider below is configured, in this order:
#   groq, anthropic, openai, openai_compatible, google
# Groq leads because its free tier is the most dependable no-spend option.
# Google trails because its free tier often returns 503 under load; set
# LLM_PROVIDER=google explicitly if you want it anyway.
# none = always use deterministic routing.
LLM_PROVIDER=auto
LLM_MODEL=                       # blank uses the provider default
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
ORCHESTRATOR_MAX_STEPS=8

# Public-deployment guards. Every orchestrator question can spend provider
# quota, so a public URL needs both a ceiling and a cache.
ORCHESTRATOR_RATE_LIMIT=20              # questions per window, per client IP
ORCHESTRATOR_RATE_WINDOW_SECONDS=3600
ORCHESTRATOR_CACHE_TTL_SECONDS=900      # 0 disables caching
ORCHESTRATOR_CACHE_MAX_ENTRIES=256

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Groq: free tier, fast, handles tool calling well, and is what auto picks
# first. This key alone is enough to turn the LangGraph orchestrator on.
#   pip install langchain-groq
GROQ_API_KEY=

# Any OpenAI-compatible endpoint. Needs langchain-openai, a base URL, a key,
# and an explicit LLM_MODEL (the id belongs to that endpoint, not to us).
#   LLM_PROVIDER=openai_compatible
#   Hugging Face  LLM_BASE_URL=https://router.huggingface.co/v1
#                 LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
#   OpenRouter    LLM_BASE_URL=https://openrouter.ai/api/v1
#                 LLM_MODEL=qwen/qwen3-14b
#   Cerebras      LLM_BASE_URL=https://api.cerebras.ai/v1
#   Together      LLM_BASE_URL=https://api.together.xyz/v1
LLM_BASE_URL=
LLM_API_KEY=

# --- Upstream data providers ----------------------------------------------
OPENWEATHER_API_KEY=
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
IMD_WEATHER_URL=
IMD_API_KEY=
