# Copy to .env and fill in what you need. Every value here is optional:
# with an empty file the service still starts, trains its models, and serves
# the dashboard using deterministic tool routing.

# --- Service ---------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text                  # text | json  (use json in deployment)

# --- HTTP ------------------------------------------------------------------
# Comma-separated exact origins. In production the loose localhost regex is
# disabled automatically, so list your real frontend origin here.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Models ----------------------------------------------------------------
AUTO_TRAIN_ON_STARTUP=true       # train missing artifacts at startup
FORECAST_HORIZON_HOURS=72
ADVISORY_CACHE_TTL_SECONDS=3600
ENABLE_PROPHET_BASELINE=false    # slow, and not used for serving

# --- LLM orchestrator ------------------------------------------------------
# auto = use whichever provider below has a key. none = always deterministic.
LLM_PROVIDER=auto                # auto | anthropic | openai | google | none
LLM_MODEL=                       # blank uses the provider default
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
ORCHESTRATOR_MAX_STEPS=8

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Upstream data providers ----------------------------------------------
OPENWEATHER_API_KEY=
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
IMD_WEATHER_URL=
IMD_API_KEY=
